# Copy to .dev.vars for local development. Set the same names with `wrangler secret put` in production.
#
# In Clerk, customize the session token so Access can name the first Owner:
#   { "email": "{{user.primary_email_address}}", "email_verified": "{{user.email_verified}}" }
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# The signing secret of the webhook endpoint pointed at /api/mux/webhook.
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# The base64 private key Mux issues with the signing key.
MUX_SIGNING_PRIVATE_KEY=
# Also needed at build time, in .env: VITE_CLERK_PUBLISHABLE_KEY=
