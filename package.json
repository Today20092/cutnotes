{
  "name": "cutnotes",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "feedback": "bun scripts/node.ts node_modules/wrangler/bin/wrangler.js d1 execute DB --remote --json --command \"SELECT * FROM feedback WHERE handled_at IS NULL ORDER BY created_at DESC\"",
    "dev:preview": "bun scripts/preview/start.ts",
    "dev": "bun scripts/node.ts node_modules/vite/bin/vite.js dev",
    "build": "bun scripts/node.ts node_modules/vite/bin/vite.js build",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate:local": "bun scripts/node.ts node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local",
    "typecheck": "bunx --bun tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt src e2e test scripts vite.config.ts vitest.config.ts playwright.config.ts drizzle.config.ts",
    "fmt:check": "oxfmt --check src e2e test scripts vite.config.ts vitest.config.ts playwright.config.ts drizzle.config.ts",
    "audit": "bun audit --audit-level=high",
    "test:seam1": "bun scripts/node.ts node_modules/vitest/vitest.mjs run",
    "test:seam2": "bun scripts/node.ts node_modules/@playwright/test/cli.js test",
    "test:player": "bun test test/player",
    "test:setup": "bun test test/setup",
    "test:structure": "bun test test/structure",
    "setup": "bun scripts/setup.ts",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test:player && bun run test:setup && bun run test:structure && bun run test:seam1",
    "check:full": "bun run check && bun run test:seam2"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@clerk/tanstack-react-start": "1.7.11",
    "@fontsource-variable/geist": "5.3.0",
    "@mux/upchunk": "3.5.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hls.js": "1.7.4",
    "lucide-react": "1.70.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "4.23.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261108.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "seroval": "1.7.10",
    "tailwindcss": "4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  },
  "optionalDependencies": {
    "node-linux-x64": "24.22.2",
    "node-win-x64": "24.22.2"
  },
  "trustedDependencies": []
}
