{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cutnotes",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cutnotes",
      // Local development only. The setup script writes the real ID here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "SHARE_LINK_COMMENT_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
    { "name": "SHARE_ADDRESS_LIMIT", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "TEAM_NAME": "Cutnotes",
    "TEAM_LOGO_URL": "",
    "APP_ORIGIN": "http://localhost:5173",
    "FIRST_OWNER_EMAIL": ""
  }
}
