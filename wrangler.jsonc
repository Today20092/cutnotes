{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cutnotes",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "review.yahalausa.net", "custom_domain": true }],
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cutnotes",
      // Local development only. The setup script writes the real ID here.
      "database_id": "865972cf-74e6-4ea3-9bfd-af2220fd53d4",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "SHARE_LINK_COMMENT_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
    { "name": "SHARE_ADDRESS_LIMIT", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "TEAM_NAME": "Haithem Studio",
    "TEAM_LOGO_URL": "",
    "APP_ORIGIN": "https://review.yahalausa.net",
    "FIRST_OWNER_EMAIL": "ayoub.abedrabbo@gmail.com"
  }
}
